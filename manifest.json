{
  "manifest_version": 3,
  "name": "ChatTrim",
  "version": "1.0.0",
  "description": "Keeps long ChatGPT chats lighter by hiding older messages and showing the latest turns first.",
  "homepage_url": "https://github.com/dkozlov/chattrim",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
